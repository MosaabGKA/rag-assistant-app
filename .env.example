# ---------------------------------------------------------------
# RAG Assistant · root env template (frontend + root tooling)
# Real runtime secrets live in backend/.env (see backend/.env.example).
# ---------------------------------------------------------------

# FastAPI backend origin that the Streamlit UI / CLI talk to.
RAG_API=http://127.0.0.1:8000

# If you point RAG_API at a remote host, set this so the UI shows the
# model it's actually talking to (cosmetic only).
RAG_LLM_MODEL=llama3.2:3b

# Debug verbosity for the app layer (INFO | DEBUG | WARNING).
APP_LOG_LEVEL=INFO
